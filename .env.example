# TMDb (client-visible, used by the React app)
# Get a free key at https://www.themoviedb.org/settings/api (v3 auth).
# App runs in demo/mock mode when this is missing.
REACT_APP_TMDB_API_KEY=your_tmdb_v3_api_key_here

# CineMate chatbot (server-only — set in Vercel dashboard, never commit real values)
# AIML.io key for the chat brain (https://aimlapi.com)
AIML_API_KEY=
# Optional model override, defaults to gpt-4o-mini
AIML_MODEL=gpt-4o-mini
# Speechmatics key for voice transcription (https://www.speechmatics.com)
SPEECHMATICS_API_KEY=
